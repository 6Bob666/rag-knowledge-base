cd D:\software\Pycharm\Project\test1\fastApiProjectOPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-v4-flash

# Optional local paths. Absolute paths are also supported.
CHROMA_PATH=chroma_data
EMBEDDING_MODEL_PATH=model/bge-small-zh-v1.5
RERANKER_MODEL_PATH=model/bge-reranker-v2-m3
RERANKER_SCORE_THRESHOLD=-inf

CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=3

# Agent Router 模式：rules（默认，零成本）或 llm（结构化决策，失败自动回退 rules）
AGENT_ROUTER_MODE=rules

# 查询改写缓存；知识库版本变化时修改 KNOWLEDGE_BASE_VERSION
QUERY_REWRITE_CACHE_ENABLED=true
QUERY_REWRITE_CACHE_TTL_SECONDS=300
QUERY_REWRITE_CACHE_MAX_ENTRIES=1024
KNOWLEDGE_BASE_VERSION=local-v1

# 会话存储：memory 适合单进程开发；redis 适合多 worker/多实例部署
CONVERSATION_STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CONVERSATION_TTL_SECONDS=86400

# 稳定性保护
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.2
LLM_TIMEOUT_SECONDS=60
TOOL_AGENT_TIMEOUT_SECONDS=120

# 失败请求记录，默认关闭；分析阶段打开后写入 logs/failure_journal.jsonl
# FAILURE_JOURNAL_ENABLED=true
